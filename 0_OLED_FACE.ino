void setup() {

  Serial.begin(9600);
  
 if(!display.begin(SSD1306_SWITCHCAPVCC, 0x3C)){
    for(;;); 
  }
}

void loop() {
delay(1000);
sad_1();
delay(300);
look_left();
delay(200);  
look_right();
delay(200);
look_squint();
delay(100);    
sad_eye();
delay(300);
display.display();
}

void look_nuetral()
{
  display.clearDisplay();  
  display.setTextColor(WHITE);
  display.setTextSize(1);
  display.setCursor(10, 20);
  display.drawBitmap(0, 0, eye_nuetral, 128, 64, 1); 
  display.display();
 
}
